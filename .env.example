# ============================================
# FILE MẪU - ĐƯỢC PHÉP ĐƯA LÊN GITHUB
# ============================================
#
# Đây là bản mẫu để biết cần những token gì.
# Trên máy mới, hãy copy file này thành .env rồi điền token thật vào.
#
# Lệnh: copy .env.example .env
# ============================================


# --- TOKEN TELEGRAM ---
# Lấy từ: nhắn tin cho @BotFather trên Telegram, gõ /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here


# --- CHAT ID TELEGRAM ---
# Lấy từ: nhắn tin cho bot @userinfobot trên Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# --- TOKEN META ADS ---
# Lấy từ: developers.facebook.com -> tạo app -> quyền ads_read
META_ADS_ACCESS_TOKEN=your_meta_ads_token_here


# --- ID TÀI KHOẢN QUẢNG CÁO ---
# Lấy từ: Trình quản lý quảng cáo Meta
META_AD_ACCOUNT_ID=act_your_account_id_here


# --- THÔNG TIN APP META (dùng để đổi token 60 ngày) ---
# Lấy từ: developers.facebook.com > App của bạn > Settings > Basic
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here


# --- API KEY CỦA AI (hiện KHÔNG dùng, có thể bỏ trống) ---
GEMINI_API_KEY=


# --- CẤU HÌNH BÁO CÁO ---
REPORT_ACCOUNT_NAME=
FILTER_INCLUDE=dainq
FILTER_EXCLUDE=thuonghieu,thương hiệu,Brand
TOP_CAMPAIGN_COUNT=5
