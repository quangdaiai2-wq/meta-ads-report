# ============================================================
#  FILE MAU - DUOC PHEP DUA LEN GITHUB
# ============================================================
#  Day la ban mau (KHONG chua token that). Tren may moi:
#     Buoc 1: copy file nay thanh .env
#     Buoc 2: mo .env bang Notepad, dien token that vao
#
#  Lenh copy (PowerShell):  copy .env.example .env
#
#  CANH BAO: Sau khi dien token that vao .env,
#            TUYET DOI KHONG dua file .env len GitHub.
#            (.gitignore da chan san)
#
#  Huong dan chi tiet: xem file HUONG-DAN-DIEN-TOKEN.md
# ============================================================


# ------------------------------------------------------------
#  1. TELEGRAM   [CAN DIEN]
# ------------------------------------------------------------
#  Bot token: nhan @BotFather tren Telegram > /newbot > lay token
#  CHU Y: sau khi tao bot, phai bam Start voi bot do 1 lan!
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

#  Chat ID: nhan @userinfobot tren Telegram > lay so "Id"
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# ------------------------------------------------------------
#  2. META ADS   [CAN DIEN]
# ------------------------------------------------------------
#  Buoc A - Token ngan han (song 1-2 gio):
#           developers.facebook.com > Tools > Graph API Explorer
#           Tick quyen ads_read > Generate Access Token
META_ADS_ACCESS_TOKEN=your_meta_ads_token_here

#  Buoc B - App ID: developers.facebook.com > Settings > Basic > App ID
#           (ID nay khong phai bi mat, dien truc tiep duoc)
META_APP_ID=your_meta_app_id_here

#  Buoc C - App Secret: cung cho voi App ID, bam "Show"
#           (Bi mat - KHONG chia se cho ai)
META_APP_SECRET=your_meta_app_secret_here

#  Buoc D - ID tai khoan quang cao: Trinh quan ly quang cao Meta
#           (Co the bat dau bang "act_", he thong tu hieu)
META_AD_ACCOUNT_ID=act_your_account_id_here

#  Buoc E - Sau khi dien xong A-D, chay lenh nay de doi
#           token ngan han thanh token 60 ngay:
#              python doi-token-60-ngay.py


# ------------------------------------------------------------
#  3. CAU HINH BAO CAO   [GIU NGUYEN - khong can sua]
# ------------------------------------------------------------
#  Danh sach moc gio bao cao, cach nhau bang dau phay. CA HAI MAY deu 8,12,17
#  (bo moc 22h tu 28/09/2026). Day la cau hinh cua TUNG MAY - copy .env giua
#  hai may thi phai kiem lai dong nay.
#  Muon lay lai moc 22h: doi thanh 8,12,17,22.
#  Neu thieu khoa nay, he thong dung mac dinh 8,12,17,22.
REPORT_SLOTS=8,12,17
REPORT_ACCOUNT_NAME=
FILTER_INCLUDE=dainq
FILTER_EXCLUDE=thuonghieu,thương hiệu,Brand
TOP_CAMPAIGN_COUNT=5


# ------------------------------------------------------------
#  4. AI VIET PHAN NHAN DINH   [CAN DIEN - xem HUONG-DAN-LAY-CHIA-KHOA-AI.md]
# ------------------------------------------------------------
#  Lay chia khoa mien phi tai: aistudio.google.com/apikey
#  Chia khoa nay la MAT KHAU - khong gui qua Zalo/Telegram/email.
GEMINI_API_KEY=

#  Ten model Gemini. De trong thi dung mac dinh trong ai.py.
#  Neu bao loi HTTP 404 thi doi ten model o day (xem huong dan cach do).
GEMINI_MODEL=

#  Model DU PHONG cho phan nhan dinh trong bao cao. De trong thi dung mac dinh
#  trong ai.py (gemini-3.5-flash).
#  Ly do co: ngay 29/09/2026, model bao cao tra HTTP 503 (qua tai) BA LAN LIEN
#  TIEP trong buoi chieu, trong khi gemini-3.5-flash van chay tot. Khong co du
#  phong thi bao cao mat phan nhan dinh suot nhieu gio.
GEMINI_MODEL_BAO_CAO_DU_PHONG=

# ------------------------------------------------------------
#  5. AI TRA LOI CAU HOI   [khong bat buoc - de trong cung chay]
# ------------------------------------------------------------
#  Model RIENG cho phan tra loi cau hoi (khac model viet bao cao o tren).
#  Ly do: han muc mien phi cua Gemini tinh RIENG cho tung model
#  (20 luot/ngay/model). Dung chung mot model thi moi cau hoi cua Dai
#  se an vao luot cua bao cao, lam bao cao mat phan nhan dinh.
GEMINI_MODEL_HOI_DAP=gemini-3.8-flash

#  Model du phong, dung khi model chinh bi qua tai (503) hoac bi khoa (404).
GEMINI_MODEL_HOI_DAP_DU_PHONG=gemini-3.5-flash

# ------------------------------------------------------------
#  6. MUC DE XUAT TRONG BAO CAO   [khong bat buoc - de trong cung chay]
# ------------------------------------------------------------
#  Tu 29/09/2026 bao cao co them muc DE XUAT: AI chi ra chien dich nen
#  tam dung. AI CHI DE XUAT, khong tu lam gi - Dai tu quyet dinh.
#
#  DE_XUAT_NGUONG_CHI: chi de xuat tam dung nhung chien dich da chi tu muc
#  nay tro len ma CHUA RA DON NAO. De 200000 = 200 nghin dong.
#  Do tren so lieu that ngay 28-29/09/2026: muc 200.000 cho ra 3-4 de xuat
#  moi ngay; muc 500.000 chi con 1-3.
#  Dat 0 neu muon thay HET moi chien dich 0 don.
DE_XUAT_NGUONG_CHI=200000

#  DE_XUAT_TOI_DA: so de xuat toi da hien ra moi bao cao.
DE_XUAT_TOI_DA=3
# ------------------------------------------------------------
#  7. AGENT NAC 2 - XIN PHEP ROI MOI TAT NHOM   [khong bat buoc]
# ------------------------------------------------------------
#  Tu 30/09/2026 co them agent.py: mot TIEN TRINH RIENG, chay nen theo nhip
#  rieng, tu phat hien nhom quang cao cham nguong roi XIN PHEP Dai qua
#  Telegram. Dai tra loi "tat <ma>" thi agent moi gui lenh len Meta.
#
#  Cach bat dau: bam bat-chay-agent.bat  (doc huong dan trong file do)
#
#  AGENT_TAP_SU: true = agent CHI NOI, KHONG gui lenh nao len Meta.
#  Day la mac dinh, va NEN giu it nhat 1-2 tuan dau: de Dai doi chieu xem
#  agent doan dung bao nhieu phan tram truoc khi cho no cam quyen that.
AGENT_TAP_SU=true

#  AGENT_MUC: 2 = xin phep (mac dinh) - 3 = tu lam trong tran (CHUA MO).
#  Chi Dai duoc doi so nay.
AGENT_MUC=2

#  AGENT_NHIP_PHUT: bao lau agent thuc day mot lan. 30 = nua tieng.
AGENT_NHIP_PHUT=30

#  AGENT_TOI_DA_NGAY: tran so lan agent duoc gui lenh len Meta moi ngay.
AGENT_TOI_DA_NGAY=3

#  Ghi chu: nac 2 HIEN CHUA DUNG AI. Vong lap chay bang LUAT CODE (doc so,
#  so nguong, xin phep) - dung nhu khuyen nghi so 1 o muc 4.4 cua ban thiet
#  ke. Nho vay khong ton luot AI mien phi nao cua bao cao. Neu sau nay can
#  AI dien giai tinh huong la, se them khoa AGENT_MODEL rieng.
